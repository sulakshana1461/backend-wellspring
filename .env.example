# Server Port (Render will set this automatically, default is 5000 or 10000)
PORT=5000

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Frontend URL for CORS (e.g. https://your-frontend.onrender.com or http://localhost:5173 for local)
# You can provide multiple comma-separated URLs:
FRONTEND_URL=https://your-frontend.onrender.com,http://localhost:5173

# Optional: Dialog eSMS Gateway Credentials (if using SMS alerts)
DIALOG_SMS_API_KEY=your_dialog_sms_api_key_here
DIALOG_SMS_MASK=Wellspring
